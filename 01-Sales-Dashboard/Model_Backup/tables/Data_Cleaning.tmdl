table Data_Cleaning
	lineageTag: 6ccd3def-f34f-4077-bb00-e20827be78f4

	measure 'Total Sales' = SUM(Data_Cleaning[Total Sale])
		formatString: #,##0.00
		displayFolder: Sales Metrics
		lineageTag: c0cab3e6-088e-49cf-9332-32c530514118

	measure 'Total Quantity' = SUM(Data_Cleaning[Quantity])
		formatString: #,##0
		displayFolder: Sales Metrics
		lineageTag: e38d4694-8cfb-4b9e-82a4-1c353c272d8e

	measure 'Total Orders' = DISTINCTCOUNT(Data_Cleaning[OrderID])
		formatString: #,##0
		displayFolder: Sales Metrics
		lineageTag: 563329e6-f61e-4931-80b8-78f88317b672

	measure 'Average Order Value' = DIVIDE([Total Sales], [Total Orders])
		formatString: #,##0.00
		displayFolder: Sales Metrics
		lineageTag: 16afaf5f-736c-4269-a655-20da8f17d665

	measure 'Sales YTD' = TOTALYTD([Total Sales], 'Date'[Date])
		formatString: #,##0.00
		displayFolder: Time Intelligence
		lineageTag: 9a7d9f47-119f-4123-8c6f-11f0ec7087da

	measure 'Sales QTD' = TOTALQTD([Total Sales], 'Date'[Date])
		formatString: #,##0.00
		displayFolder: Time Intelligence
		lineageTag: 00c6a22b-dd79-4a7a-a6d5-8c94563db19e

	measure 'Sales MTD' = TOTALMTD([Total Sales], 'Date'[Date])
		formatString: #,##0.00
		displayFolder: Time Intelligence
		lineageTag: 20a04d07-c54e-44ac-b982-f0e217813958

	measure 'Sales Last Year' = CALCULATE([Total Sales], SAMEPERIODLASTYEAR('Date'[Date]))
		formatString: #,##0.00
		displayFolder: Time Intelligence
		lineageTag: 621d8286-1764-4a99-99a1-04e9237013e9

	measure 'Sales YoY Change' = [Total Sales] - [Sales Last Year]
		formatString: #,##0.00;-#,##0.00
		displayFolder: Time Intelligence
		lineageTag: 88dc02b2-fc59-4c03-a6c4-34e044abff75

	measure 'Sales YoY %' = DIVIDE([Sales YoY Change], [Sales Last Year])
		formatString: 0.0%;-0.0%
		displayFolder: Time Intelligence
		lineageTag: 5dd22593-b183-4a3d-b50d-4d2c47f7b7ce

	measure 'Sales Previous Month' = CALCULATE([Total Sales], DATEADD('Date'[Date], -1, MONTH))
		formatString: #,##0.00
		displayFolder: Time Intelligence
		lineageTag: 72f318e3-bdee-4c68-929c-39b64ad30ec4

	measure 'Sales MoM %' = DIVIDE([Total Sales] - [Sales Previous Month], [Sales Previous Month])
		formatString: 0.0%;-0.0%
		displayFolder: Time Intelligence
		lineageTag: bb02b902-8651-4e16-abd1-d515b5870f83

	measure 'Sales % of Total' = DIVIDE([Total Sales], CALCULATE([Total Sales], ALLSELECTED(Data_Cleaning)))
		formatString: 0.0%
		displayFolder: Share & Ranking
		lineageTag: 375ae557-9634-412e-a501-da04c1c7151d

	measure 'Region % of Sales' = DIVIDE([Total Sales], CALCULATE([Total Sales], ALLSELECTED(Data_Cleaning[Region])))
		formatString: 0.0%
		displayFolder: Share & Ranking
		lineageTag: 17ceeafd-ce87-4a20-a6f2-20f3a5c2ccd4

	measure 'Category % of Sales' = DIVIDE([Total Sales], CALCULATE([Total Sales], ALLSELECTED(Data_Cleaning[Category])))
		formatString: 0.0%
		displayFolder: Share & Ranking
		lineageTag: 442d227e-3742-41b9-b97c-d421e0e6e81a

	measure 'Product Rank' = RANKX(ALLSELECTED(Data_Cleaning[Product Name]), [Total Sales], , DESC, Dense)
		formatString: 0
		displayFolder: Share & Ranking
		lineageTag: 127e21e2-4fbc-4496-9691-705ca834171e

	measure 'Total Customers' = DISTINCTCOUNT(Data_Cleaning[CustomerName])
		formatString: #,##0
		displayFolder: Share & Ranking
		lineageTag: 3c93de43-7a3f-4cfd-9b24-86dc45291d90

	measure 'Avg Units per Order' = DIVIDE([Total Quantity], [Total Orders])
		formatString: #,##0.0
		displayFolder: Sales Metrics
		lineageTag: 4ae572e9-3847-4147-ba78-5b3bc9aa9aaf

	measure 'Average Sales' = CALCULATE(AVERAGE(Data_Cleaning[Total Sale]),'Date'[Date])
		displayFolder: Sales Metrics
		lineageTag: fa1a08c9-0998-483a-b43a-9f8c8c988c9a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Monthly Sales' = AVERAGEX(ALLSELECTED('Date'[Year-Month]), [Total Sales])
		formatString: #,##0.00
		displayFolder: Trend
		lineageTag: 0cbfa365-d4c3-4c81-88ef-133b6756ab84

	measure '3M Moving Avg' =
			VAR _Last3Months = DATESINPERIOD('Date'[Date], MAX('Date'[Date]), -3, MONTH)
			RETURN
			DIVIDE(CALCULATE([Total Sales], _Last3Months), 3)
		formatString: #,##0.00
		displayFolder: Trend
		lineageTag: 2f115ec0-2777-4bff-ae6c-3e737fddbdf4

