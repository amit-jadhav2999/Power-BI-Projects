		summarizeBy: sum
		sourceColumn: Total Sale

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"brx-IN"}

	column Region
		dataType: string
		lineageTag: b57c5b32-2846-4527-b7f2-07d139c06e99
		dataCategory: StateOrProvince
		summarizeBy: none
		sourceColumn: Region

